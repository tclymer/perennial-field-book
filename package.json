{
  "name": "perennial-field-book",
  "private": true,
  "version": "0.8.3",
  "type": "module",
  "description": "Map your orchard, find every tree, keep its history. Your data stays in your browser.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "api": "wrangler pages dev public --port 8788",
    "db:migrate:local": "wrangler d1 migrations apply fieldbook --local",
    "db:migrate": "wrangler d1 migrations apply fieldbook --remote",
    "deploy": "wrangler pages deploy --project-name=perennial-field-book --branch=main --commit-dirty=true",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"server/**/*.ts\" \"functions/**/*.ts\" \"scripts/**/*.mjs\" \"*.{ts,json,md}\"",
    "lint": "prettier --check .",
    "icons": "node scripts/icons.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "dexie": "^4.4.6",
    "maplibre-gl": "^6.10.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "terra-draw": "^1.33.0",
    "terra-draw-maplibre-gl-adapter": "^1.4.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260917.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "miniflare": "^5.20260917.0-alpha",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.134.0"
  },
  "license": "MIT",
  "author": "Threefold Farm"
}
