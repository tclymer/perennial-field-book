// Cloudflare Pages project: the built site in dist/ plus the API in functions/ (DESIGN.md §8.3).
// `wrangler pages deploy` reads this for the output directory and the bindings; `wrangler
// pages dev` uses it for local D1 and R2 under .wrangler/. Secrets (GOOGLE_CLIENT_SECRET and
// friends) are never here: .dev.vars locally, the Pages project's environment variables live.
{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "perennial-field-book",
  "compatibility_date": "2025-09-01",
  "pages_build_output_dir": "./dist",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fieldbook",
      // Set by `wrangler d1 create fieldbook` (DESIGN.md §8.7).
      "database_id": "00000000-0000-0000-0000-000000000000",
    },
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "fieldbook-photos",
    },
  ],
}
